<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Admin_Greg.Admin_Dashboard"
    android:orientation="vertical"
    android:gravity="center_horizontal">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textStyle="bold"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create New User"
        android:id="@+id/btn_AdminDashboardCreateUser"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View All Users"
        android:id="@+id/btn_AdminDashboardViewAllUsers"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verify New Jobs"
        android:id="@+id/btn_AdminDashboardVerifyNewJobs"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close Finished Jobs"
        android:id="@+id/btn_AdminDashboardCloseFinishedJobs"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Jobs"
        android:id="@+id/btn_Admin_DashboardDeleteJobs"/>

</LinearLayout>
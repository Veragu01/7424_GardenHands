<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Admin_Greg.Admin_Dashboard"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:layout_marginVertical="32dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create New User"
        android:id="@+id/btn_AdminDashboardCreateUser"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="12sp"
        android:backgroundTint="@color/primary_green"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View All Users"
        android:id="@+id/btn_AdminDashboardViewAllUsers"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="12sp"
        android:backgroundTint="@color/primary_green"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View All Jobs"
        android:id="@+id/btn_AdminDashboardViewAllJobs"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="12sp"
        android:backgroundTint="@color/primary_green"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verify New Jobs"
        android:id="@+id/btn_AdminDashboardVerifyNewJobs"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="12sp"
        android:backgroundTint="@color/primary_green"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close Finished Jobs"
        android:id="@+id/btn_AdminDashboardCloseFinishedJobs"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="12sp"
        android:backgroundTint="@color/primary_green"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Jobs"
        android:id="@+id/btn_Admin_DashboardDeleteJobs"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="12sp"
        android:backgroundTint="@color/primary_green"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log Out"
        android:id="@+id/btn_AdminDashboardLogOut"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:backgroundTint="@color/red"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Gardener_Uly.ProvideQuote.Gardener_ProvideQuote"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green"


    >
    <TextView
        android:id="@+id/txtGPQ_Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="42sp"
        android:layout_marginBottom="24sp"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:text="Provide a Quote"
        android:textStyle="bold"
        />

    <LinearLayout
        android:id="@+id/GPQ_FormLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        >
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGPQ_DateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginVertical="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10sp"
                android:layout_marginVertical="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proposed Date:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <DatePicker
                    android:id="@+id/dpGPQ_CalendarSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:datePickerMode="spinner"
                    android:calendarViewShown="false"
                    android:theme="@style/MyDatePicker"

                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <RadioButton
                        android:id="@+id/rbGPQ_AM"
                        android:text="AM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5dp"
                        android:textColor="@color/black"
                        android:buttonTint="@color/primary_green"
                        android:checked="true"
                        />

                    <RadioButton
                        android:id="@+id/rbGPQ_PM"
                        android:text="PM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5dp"
                        android:textColor="@color/black"
                        />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGPQ_FeeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginBottom="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10sp"
                android:layout_marginVertical="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fee:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        />
                    <EditText
                        android:id="@+id/txtGPQ_Fee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="250sp"
                        android:hint="000.00"
                        android:textColorHint="@color/light_grey"
                        android:inputType="numberDecimal"
                        android:textColor="@color/black"
                        />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginBottom="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10sp"
                android:layout_marginVertical="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <EditText
                    android:id="@+id/txtGPQ_Notes"
                    android:layout_width="match_parent"
                    android:layout_height="100sp"
                    android:layout_marginRight="10sp"
                    android:gravity="top"
                    android:text=""
                    android:hint="Additional notes..."
                    android:textColorHint="@color/light_grey"
                    android:background="@color/very_light_green"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0sp"
        android:layout_weight="1"
        />
    <Button
        android:id="@+id/btnGPQ_SendQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Quote"
        android:textSize="16sp"
        android:textColor="@color/off_white"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="5sp"
        android:backgroundTint="@color/primary_green"
        />
    <Button
        android:id="@+id/btnGPQCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="16sp"
        android:textColor="@color/off_white"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="15sp"
        android:backgroundTint="@color/red"
        />


</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Gardener_Uly.WeeklyCalendar.Gardener_WeeklyCalendar"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weekly Planner"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:layout_marginTop="48sp"
        android:layout_marginBottom="24sp"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24sp"
        android:gravity="center_vertical"
        >
        <ImageButton
            android:id="@+id/btnGWP_PreviousWeek"
            android:layout_width="30dp"
            android:layout_height="30sp"
            android:src="@drawable/icons8_back_100"
            android:contentDescription="Settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            />

        <TextView
            android:id="@+id/txtGWP_CurrentWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Week of: 00 Mon"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginHorizontal="16sp"
            />
        <ImageButton
            android:id="@+id/btnGWP_NextWeek"
            android:layout_width="30dp"
            android:layout_height="30sp"
            android:src="@drawable/icons8_forward_100"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="24sp"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txtGWP_MondayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monday"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            />
        <TextView
            android:id="@+id/txtGWP_MondayAM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/off_white"
            />
        <TextView
            android:id="@+id/txtGWP_MondayPM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/very_light_green"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="24sp"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txtGWP_TuesdayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuesday"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            />
        <TextView
            android:id="@+id/txtGWP_TuesdayAM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/off_white"
            />
        <TextView
            android:id="@+id/txtGWP_TuesdayPM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/very_light_green"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="24sp"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txtGWP_WednesdayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wednesday"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            />
        <TextView
            android:id="@+id/txtGWP_WednesdayAM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/off_white"
            />
        <TextView
            android:id="@+id/txtGWP_WednesdayPM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/very_light_green"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="24sp"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txtGWP_ThursdayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thursday"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            />
        <TextView
            android:id="@+id/txtGWP_ThursdayAM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/off_white"
            />
        <TextView
            android:id="@+id/txtGWP_ThursdayPM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/very_light_green"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="24sp"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txtGWP_FridayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Friday"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            />
        <TextView
            android:id="@+id/txtGWP_FridayAM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/off_white"
            />
        <TextView
            android:id="@+id/txtGWP_FridayPM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PM: "
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/very_light_green"
            />
    </LinearLayout>



</LinearLayout>
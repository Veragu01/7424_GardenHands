<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Admin_Greg.Users.ViewSelectUser.Admin_ViewSelectUser"
    android:orientation="vertical"
    android:layout_gravity="center_horizontal"
    android:background="@color/background_green"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="User Details"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Name:"
            android:textAlignment="textEnd"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edit_usercard_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:inputType="none"
            android:enabled="false"/>
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:text="User group:"
                android:textAlignment="textEnd"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/edit_usercard_usergroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:inputType="none"
                android:enabled="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:text="Email:"
                android:textAlignment="textEnd"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/edit_usercard_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:inputType="none"
                android:enabled="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:text="Phone:"
                android:textAlignment="textEnd"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/edit_usercard_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:inputType="none"
                android:enabled="false"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:text="Authorised:"
                android:textAlignment="textEnd"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/edit_usercard_authorised"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:inputType="none"
                android:enabled="false"
                android:autofillHints="'true' or 'false'"/>
        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="24dp">

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:id="@+id/btn_usercard_edit"
            android:text="Edit Details"
            android:textColor="@color/off_white"
            android:backgroundTint="@color/primary_green"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:id="@+id/btn_usercard_save"
            android:text="Save Changes"
            android:textColor="@color/off_white"
            android:backgroundTint="@color/primary_green"
            android:visibility="gone"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="24dp">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:id="@+id/btn_usercard_deactivate"
            android:text="DEACTIVATE USER"
            android:textColor="@color/off_white"
            android:backgroundTint="@color/red"
            android:visibility="gone"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:id="@+id/btn_usercard_activate"
            android:text="ACTIVATE USER"
            android:textColor="@color/off_white"
            android:backgroundTint="@color/primary_green"
            android:visibility="gone"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:id="@+id/btn_usercard_deactivate_confirm"
            android:text="CONFIRM"
            android:textColor="@color/off_white"
            android:backgroundTint="@color/red"
            android:visibility="gone"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:id="@+id/btn_usercard_deactivate_cancel"
            android:text="CANCEL"
            android:textColor="@color/off_white"
            android:backgroundTint="@color/dark_grey"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Gardener_Uly.Gardener_Dashboard"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer's Dashboard"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:layout_marginVertical="48sp"
        />

    <Button
        android:id="@+id/btnCDashCreateJob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Job"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="16sp"
        android:backgroundTint="@color/primary_green"
        />
    <Button
        android:id="@+id/btnCDashMyJobs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Jobs"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="16sp"
        android:backgroundTint="@color/primary_green"
        />

    <Button
        android:id="@+id/btnCDashMyProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:textColor="@color/off_white"
        android:textSize="16sp"
        android:layout_marginHorizontal="24sp"
        android:layout_marginBottom="16sp"
        android:backgroundTint="@color/primary_green"
        />



</LinearLayout>
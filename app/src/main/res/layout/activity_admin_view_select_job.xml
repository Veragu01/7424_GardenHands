<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Admin_Greg.Jobs.ViewSelectJob.Admin_ViewSelectJob"
    android:orientation="vertical"
    android:layout_gravity="center_horizontal"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Job Details"
        android:textStyle="bold"
        android:textSize="30sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Job title:"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_jobcard_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="18sp"
            android:inputType="none"
            android:enabled="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:text="Customer:"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/edit_jobcard_customer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginTop="8dp"
            android:textSize="18sp"
            android:inputType="none"
            android:enabled="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:text="Gardener:"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/edit_jobcard_gardener"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginTop="8dp"
            android:textSize="18sp"
            android:inputType="none"
            android:enabled="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:text="Location:"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/edit_jobcard_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginTop="8dp"
            android:textSize="18sp"
            android:inputType="none"
            android:enabled="false" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Description:"
        android:textStyle="bold"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edit_jobcard_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:textSize="16sp"
        android:inputType="none"
        android:enabled="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:text="Status:"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/edit_jobcard_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginTop="12dp"
            android:textSize="18sp"
            android:inputType="none"
            android:enabled="false" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_jobcard_verify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="VERIFY JOB"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_jobcard_deny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DENY JOB"
        android:backgroundTint="@android:color/holo_red_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_jobcard_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="CLOSE JOB"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_jobcard_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="DELETE JOB"
        android:backgroundTint="@android:color/holo_red_light"
        android:visibility="gone" />

</LinearLayout>

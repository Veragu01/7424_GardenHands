<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Gardener_Uly.MyProfile.Gardeners_UpdateProfile"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Profile"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:layout_marginTop="42sp"
        android:layout_marginBottom="16sp"
        />
    <ProgressBar
        android:id="@+id/pbGUpdateProfileLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/dark_grey"
        android:visibility="gone"/>
    <LinearLayout
        android:id="@+id/GardenerUpdateProfileFieldsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        >
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crdNameCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginVertical="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10sp"
                android:layout_marginVertical="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Company Name:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <EditText
                    android:id="@+id/txtGUPName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Company Name"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crdEmailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginBottom="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10sp"
                android:layout_marginVertical="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Email:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <EditText
                    android:id="@+id/txtGUPEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="contact@email.com"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crdPhoneCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginBottom="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10sp"
                android:layout_marginVertical="10sp"
                android:layout_marginHorizontal="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Phone:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <EditText
                    android:id="@+id/txtGUPPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="02123456789"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:inputType="phone"
                    />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crdPasswordCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginBottom="15sp"
            app:cardCornerRadius="10sp"
            android:backgroundTint="@color/off_white"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10sp"
                android:layout_marginVertical="10sp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <EditText
                    android:id="@+id/txtGUP_Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:hint="Enter New Password"
                    android:textColorHint="@color/light_grey"
                    android:layout_marginBottom="16sp"
                    android:inputType="textPassword"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Password:"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <EditText
                    android:id="@+id/txtGUP_ConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:hint="Enter New Password"
                    android:textColorHint="@color/light_grey"
                    android:inputType="textPassword"
                    />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />

    <Button
        android:id="@+id/btnGUP_UpdateDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update"
        android:textSize="16sp"
        android:textColor="@color/off_white"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="5sp"
        android:backgroundTint="@color/primary_green"
        />
    <Button
        android:id="@+id/btnGUPCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="16sp"
        android:textColor="@color/off_white"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="15sp"
        android:backgroundTint="@color/red"
        />



</LinearLayout>
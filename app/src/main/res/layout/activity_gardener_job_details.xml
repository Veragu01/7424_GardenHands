<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Gardener_Uly.JobDetails.Gardener_JobDetails"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green">

    <LinearLayout
        android:id="@+id/GJD_JobLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible"
        >
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42sp"
            android:indeterminateTint="@color/dark_grey"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="@color/dark_grey"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/GJD_JobLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible"
        >
        <TextView
            android:id="@+id/txtGJD_Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginTop="42sp"
            android:layout_marginBottom="24sp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:text="Job Title"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/txtGJD_Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginVertical="10sp"
            android:text="Job Description text"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:maxHeight="300sp"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="left"
            android:layout_marginHorizontal="16sp"
            android:layout_marginTop="16sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Job Type:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/txtGJD_JobType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12sp"
                android:text="Job Description text"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="left"
            android:layout_marginHorizontal="16sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Job Size:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/txtGJD_JobSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16sp"
                android:text="Job Description text"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="left"
            android:layout_marginHorizontal="16sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/txtGJD_JobLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16sp"
                android:text="Job Description text"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/GJD_DateLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="left"
            android:layout_marginHorizontal="16sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Job Date:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/txtGJD_JobDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15sp"
                android:text="Job Description text"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/GJD_FeeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="left"
            android:layout_marginHorizontal="16sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Job Fee:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/txtGJD_JobFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20sp"
                android:text="Job Fee text"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
        </LinearLayout>
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />
    <Button
        android:id="@+id/btnGJD_ProvideQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Provide Quote"
        android:textSize="16sp"
        android:textColor="@color/off_white"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="16sp"
        android:backgroundTint="@color/primary_green"
        android:visibility="gone"
        />
    <LinearLayout
        android:id="@+id/GJD_MyJobLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >
        <Button
            android:id="@+id/btnGJD_MarkAsCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark As Completed"
            android:textSize="16sp"
            android:textColor="@color/off_white"
            android:layout_marginHorizontal="16sp"
            android:layout_marginBottom="16sp"
            android:backgroundTint="@color/primary_green"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <Button
                android:id="@+id/btnGJD_Email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="16sp"
                android:textColor="@color/off_white"
                android:paddingHorizontal="64sp"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="16sp"
                android:backgroundTint="@color/primary_green"
                />
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                />
            <Button
                android:id="@+id/btnGJD_Call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call"
                android:textSize="16sp"
                android:textColor="@color/off_white"
                android:paddingHorizontal="64sp"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="16sp"
                android:backgroundTint="@color/primary_green"
                />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
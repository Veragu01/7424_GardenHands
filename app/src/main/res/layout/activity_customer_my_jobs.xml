<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Customer_Aidan.Customer_My_Jobs"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="45dp"
    android:background="@color/background_green">

    <TextView
        android:id="@+id/tvMyJobsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Jobs"
        android:textStyle="bold"
        android:textSize="20sp"/>

    <ProgressBar
        android:id="@+id/pbLoadingJobs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="20dp"
        android:indeterminateTint="@color/primary_green"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvEmptyJobs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="20dp"
        android:text="No jobs created yet."
        android:textColor="@color/dark_grey"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomerJobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

    <Button
        android:id="@+id/btnBackDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:backgroundTint="@color/primary_green"
        android:paddingVertical="12dp"
        android:text="Back to Dashboard"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>